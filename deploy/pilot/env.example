# Copy outside the checkout; values below are references, never credentials.
# This file is deliberately incomplete: pilot.py rejects missing secrets.
PILOT_PROJECT=docere-pilot-local
PILOT_PORT=18443
PILOT_HOST=localhost
PILOT_ORIGIN=https://localhost:18443
PILOT_API_IMAGE=docere-pilot-api:d4
PILOT_FRONTEND_IMAGE=docere-pilot-frontend:d4
PILOT_AUTH_KEY_FILE=
PILOT_POSTGRES_PASSWORD_FILE=
PILOT_REDIS_PASSWORD_FILE=
PILOT_STORAGE_ACCESS_KEY_FILE=
PILOT_STORAGE_SECRET_KEY_FILE=
PILOT_TLS_CERT_FILE=
PILOT_TLS_KEY_FILE=
PILOT_AI_TOKEN_FILE=
PILOT_AI_ENABLED=false
PILOT_AI_BASE_URL=
PILOT_AI_MODEL=
